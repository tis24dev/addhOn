  "options": {
    "step": {
      "init": {
        "title": "Opzioni",
        "data": {
          "enable_debug": "Abilita log di debug",
          "enable_mqtt_debug": "Abilita debug MQTT realtime",
          "enable_experimental": "Abilita entità sperimentali"
        },
        "data_description": {
          "enable_debug": "Porta il livello di log dell'integrazione a DEBUG (accesso, rilevamento dispositivi, polling, comandi). Disattiva per tornare al livello configurato in Home Assistant. Il rumore MQTT realtime resta silenziato a meno che non attivi il suo toggle.",
          "enable_mqtt_debug": "Rende molto verboso il canale MQTT realtime. Di norma tienilo disattivato; copre solo il logger MQTT di questa integrazione, non le librerie AWS IoT sottostanti (per quelle usa la configurazione logger di Home Assistant).",
          "enable_experimental": "Aggiunge entità il cui significato si basa su indizi incompleti: possono essere sbagliate, cambiare nome o sparire. Restano non disponibili per ogni lettura non confermata. Cambiare questa opzione ricarica l'integrazione."
        }
      }
    }
  },
  "services": {
    "refresh": {
      "name": "Aggiorna ora",
      "description": "Forza un polling immediato dal cloud per tutti gli account hOn configurati. L'equivalente richiamabile da automazione del pulsante \"Aggiorna ora\" per dispositivo: chiede a ogni coordinator caricato di recuperare subito i dati aggiornati, senza attendere il prossimo polling pianificato. Non richiede opzioni e si applica all'intera integrazione."
    },
    "set_log_level": {
      "name": "Imposta livello log diagnostico",
      "description": "Cambia il livello di log dell'integrazione Haier hOn e dei logger del client hOn nativo utili a diagnosticare login, discovery dispositivi, reauth e polling. Usa \"debug\" quando i dispositivi non appaiono, poi torna a \"warning\" per ridurre il rumore. Non abilita il rumore MQTT realtime: per quello usa il service dedicato set_mqtt_log_level.",
      "fields": {
        "level": {
          "name": "Livello",
          "description": "Livello di log diagnostico da applicare."
        }
      }
    },
    "set_mqtt_log_level": {
      "name": "Imposta livello log MQTT",
      "description": "Cambia il livello di log del canale MQTT realtime hOn. Di default il rumore dei tentativi di riconnessione è silenziato (warning). Imposta \"debug\" per diagnosticare i problemi di push realtime, poi \"warning\" per risilenziare. Non persiste: al riavvio di Home Assistant torna silenziato.",
      "fields": {
        "level": {
          "name": "Livello",
          "description": "Livello di log da applicare al canale MQTT realtime hOn."
        }
      }
    }
  },
