  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "enable_debug": "Activer la journalisation de débogage",
          "enable_mqtt_debug": "Activer le débogage MQTT en temps réel",
          "enable_experimental": "Activer les entités expérimentales"
        },
        "data_description": {
          "enable_debug": "Élève le niveau de journalisation de cette intégration à DEBUG (connexion, découverte des appareils, interrogation, commandes). Désactivez pour revenir au niveau configuré dans Home Assistant. Le bruit MQTT en temps réel reste supprimé sauf si son propre interrupteur est activé.",
          "enable_mqtt_debug": "Rend le canal MQTT en temps réel très verbeux. Laissez normalement cette option désactivée ; elle ne couvre que le journal MQTT de cette intégration, pas les bibliothèques AWS IoT sous-jacentes (utilisez la configuration des journaux de Home Assistant pour celles-ci).",
          "enable_experimental": "Ajoute des entités dont le sens repose sur des preuves incomplètes : elles peuvent être erronées, être renommées, ou disparaître à nouveau. Elles restent indisponibles pour toute lecture non confirmée. Modifier cette option recharge l'intégration."
        }
      }
    }
  },
  "services": {
    "refresh": {
      "name": "Actualiser maintenant",
      "description": "Force une interrogation immédiate du cloud pour tous les comptes hOn configurés. L'équivalent, appelable depuis une automatisation, du bouton \"Actualiser maintenant\" par appareil : il demande à chaque coordinateur chargé de récupérer immédiatement les données à jour, au lieu d'attendre la prochaine interrogation planifiée. Ne prend aucune option et s'applique à toute l'intégration."
    },
    "set_log_level": {
      "name": "Définir le niveau de journalisation de diagnostic",
      "description": "Change le niveau de journalisation de l'intégration Haier hOn et des journaux du client hOn natif utilisés pour diagnostiquer la connexion, la découverte des appareils, la ré-authentification et l'interrogation. Utilisez \"debug\" quand les appareils n'apparaissent pas, puis revenez à \"warning\" pour réduire le bruit. N'active pas le bruit MQTT en temps réel : pour cela, utilisez le service dédié set_mqtt_log_level.",
      "fields": {
        "level": {
          "name": "Niveau",
          "description": "Niveau de journalisation de diagnostic à appliquer."
        }
      }
    },
    "set_mqtt_log_level": {
      "name": "Définir le niveau de journalisation MQTT",
      "description": "Change le niveau de journalisation du canal MQTT en temps réel hOn. Par défaut, le bruit des tentatives de reconnexion est masqué (warning). Réglez sur \"debug\" pour diagnostiquer les problèmes de notification en temps réel, puis sur \"warning\" pour le masquer à nouveau. Non persistant : il revient à masqué après un redémarrage de Home Assistant.",
      "fields": {
        "level": {
          "name": "Niveau",
          "description": "Niveau de journalisation à appliquer au canal MQTT en temps réel hOn."
        }
      }
    },
    "set_eco_schedule": {
      "name": "Définir les plages éco",
      "description": "Chauffe-eau thermodynamique : écrit les plages éco comme le fait l'application hOn (le schéma, puis les jours, puis les plages ; un schéma ou des jours inchangés ne sont pas renvoyés), une étape à la fois, chacune confirmée par l'appareil avant la suivante, environ 15 secondes par étape. Uniquement en mode Éco, avec l'option expérimentale activée, sur les séries m7 et m8.",
      "fields": {
        "scheme": {
          "name": "Schéma",
          "description": "same : les mêmes plages chaque jour. different : les plages ci-dessous les jours choisis, les autres plages les autres jours."
        },
        "days": {
          "name": "Jours",
          "description": "Uniquement avec different : les jours consécutifs, du lundi au dimanche, qui utilisent les plages ci-dessous."
        },
        "windows": {
          "name": "Plages",
          "description": "Jusqu'à 3 plages écrites HH:MM-HH:MM, minutes 00, 15, 30 ou 45. Chaque jour avec same, les jours choisis avec different. Vide : aucune plage."
        },
        "other_windows": {
          "name": "Autres plages",
          "description": "Uniquement avec different : jusqu'à 3 plages pour les autres jours."
        }
      }
    }
  },
